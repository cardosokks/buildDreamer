datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String
  name            String?
  geminiApiKey    String?
  openaiApiKey    String?
  aiProxyUrl      String?
  ngrokAuthToken  String?
  customAiSkills  Json?
  customAiModels  Json?
  savedLeads      Json?
  filterPresets   Json?
  projects        ProjectMember[]
  crmLeads        Lead[]
  createdAt       DateTime        @default(now())
}

model Lead {
  id              String          @id @default(uuid())
  name            String
  company         String?
  phone           String?
  email           String?
  website         String?
  address         String?
  rating          String?
  dealValue       Float           @default(0)
  status          String          @default("PROSPECT") // PROSPECT, CONTACTED, PROPOSAL_SENT, IN_NEGOTIATION, WON, LOST
  notes           String?
  origin          String?         @default("MANUAL") // SEARCH, MANUAL, IMPORT
  tags            String[]        @default([])
  lastContactDate DateTime?
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Project {
  id           String          @id @default(uuid())
  name         String
  description  String?
  status       String          @default("development") // development, published
  domain       String?         @unique
  favicon      String?
  navbarHtml   String          @default("")
  footerHtml   String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      ProjectMember[]
  pages        Page[]
  assets       Asset[]
  versions     Version[]
  crmLeads     Lead[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  role      String   @default("OWNER") // OWNER, ADMIN, EDITOR, VIEWER
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
  id             String   @id @default(uuid())
  name           String
  slug           String
  title          String?
  description    String?
  html           String   @default("<div></div>")
  css            String   @default("")
  js             String   @default("")
  seoTitle       String?
  seoDescription String?
  isHomepage     Boolean  @default(false)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  name      String
  type      String   // image, video, font, icon
  url       String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Version {
  id          String   @id @default(uuid())
  name        String
  description String?
  snapshot    Json     // Estado completo das páginas e arquivos do projeto
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
